#!/usr/bin/env python3

from __future__ import annotations

import argparse
import concurrent.futures
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

SCHEMA_VERSION = 1
PLUGIN_ID = "io.github.idr4n.bookmarks"
URL_RE = re.compile(r"https?://[^\s|]+", re.IGNORECASE)
URL_PARTS_RE = re.compile(r"^(https?)://([^/?#\s\x00-\x1f\x7f\ufeff]+)([^\s\x00-\x1f\x7f\ufeff]*)$", re.IGNORECASE)
TAG_RE = re.compile(r"(?<!\S)#([\w-]+)(?!\S)", re.UNICODE)
EDGE_SEPARATORS = " \t\r\n|,:;-–—"
FAVICON_RE = re.compile(r"^favicons/[0-9a-f]{64}\.(?:gif|ico|jpg|png|webp)$")
BACKFILL_CHECKPOINT = 8
MAX_BACKFILL_WORKERS = 8


class ImportFailure(Exception):
    pass


@dataclass
class ImportStats:
    valid: int = 0
    imported: int = 0
    duplicate: int = 0
    malformed: int = 0
    ambiguous: int = 0
    rows_with_tags: int = 0
    tag_tokens: int = 0
    ambiguous_lines: list[int] = field(default_factory=list)


@dataclass
class BackfillStats:
    missing: int = 0
    scheduled: int = 0
    processed: int = 0
    fetched: int = 0
    failed: int = 0
    applied: int = 0
    skipped: int = 0


def default_data_file() -> Path:
    configured = os.environ.get("XDG_DATA_HOME", "")
    if configured and os.path.isabs(configured):
        data_home = Path(configured)
    else:
        data_home = Path.home() / ".local" / "share"
    return data_home / PLUGIN_ID / "bookmarks.json"


def parse_http_url(value: str) -> tuple[str, str, str, str] | None:
    if not isinstance(value, str) or value != value.strip():
        return None
    match = URL_PARTS_RE.fullmatch(value)
    if not match:
        return None

    authority = match.group(2)
    if not authority or "\\" in authority:
        return None
    host_port = authority
    if "@" in authority:
        if authority.endswith("@"):
            return None
        host_port = authority.rsplit("@", 1)[1]

    port = ""
    if host_port.startswith("["):
        closing_bracket = host_port.find("]")
        if closing_bracket <= 1:
            return None
        host = host_port[1:closing_bracket]
        remainder = host_port[closing_bracket + 1 :]
        if remainder:
            if not re.fullmatch(r":[0-9]+", remainder):
                return None
            port = remainder[1:]
    else:
        if "[" in host_port or "]" in host_port or host_port.count(":") > 1:
            return None
        if ":" in host_port:
            host, port = host_port.rsplit(":", 1)
            if not re.fullmatch(r"[0-9]+", port):
                return None
        else:
            host = host_port

    if not host or any(character in host for character in "/?#@"):
        return None
    if port and int(port) > 65535:
        return None
    return match.group(1), authority, match.group(3), host


def duplicate_key(url: str) -> str:
    parsed = parse_http_url(url)
    if not parsed:
        raise ImportFailure("invalid URL")
    scheme, authority, suffix, _host = parsed
    return f"{scheme.lower()}://{authority.lower()}{suffix}"


def deterministic_id(url: str) -> str:
    digest = hashlib.sha256(duplicate_key(url).encode("utf-8")).hexdigest()
    return f"bkm_{digest[:24]}"


def clean_fragment(value: str) -> str:
    return re.sub(r"\s+", " ", value).strip(EDGE_SEPARATORS)


def extract_tags(fragment: str) -> tuple[str, list[str], int]:
    protected = [match.span() for match in URL_RE.finditer(fragment)]
    tags: list[str] = []
    pieces: list[str] = []
    cursor = 0

    for match in TAG_RE.finditer(fragment):
        if any(start <= match.start() < end for start, end in protected):
            continue
        pieces.append(fragment[cursor : match.start()])
        cursor = match.end()
        tags.append(match.group(1).lower())

    pieces.append(fragment[cursor:])
    return "".join(pieces), tags, len(tags)


def imported_timestamp() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def parse_legacy(source: Path) -> tuple[list[dict[str, Any]], ImportStats]:
    try:
        text = source.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        raise ImportFailure("could not read the legacy source") from error

    stats = ImportStats()
    records: list[dict[str, Any]] = []
    seen_keys: dict[str, int] = {}
    seen_ids: dict[str, str] = {}
    created_at = imported_timestamp()

    for line_number, raw_line in enumerate(text.splitlines(), start=1):
        line = raw_line.strip()
        if not line:
            continue

        urls = list(URL_RE.finditer(line))
        if not urls:
            stats.malformed += 1
            continue

        first = urls[0]
        url = first.group(0)
        parsed_url = parse_http_url(url)
        if not parsed_url:
            stats.malformed += 1
            continue

        stats.valid += 1
        if len(urls) > 1:
            stats.ambiguous += 1
            stats.ambiguous_lines.append(line_number)

        before, before_tags, before_count = extract_tags(line[: first.start()])
        after, after_tags, after_count = extract_tags(line[first.end() :])
        raw_tags = before_tags + after_tags
        stats.tag_tokens += before_count + after_count
        if raw_tags:
            stats.rows_with_tags += 1

        tags: list[str] = []
        seen_tags: set[str] = set()
        for tag in raw_tags:
            if tag in seen_tags:
                continue
            seen_tags.add(tag)
            tags.append(tag)

        title_parts = [part for part in (clean_fragment(before), clean_fragment(after)) if part]
        title = " ".join(title_parts)
        if not title:
            title = parsed_url[3].lower()

        key = duplicate_key(url)
        if key in seen_keys:
            stats.duplicate += 1
            continue
        seen_keys[key] = line_number

        record_id = deterministic_id(url)
        prior_key = seen_ids.get(record_id)
        if prior_key is not None and prior_key != key:
            raise ImportFailure("deterministic ID collision")
        seen_ids[record_id] = key

        records.append(
            {
                "id": record_id,
                "title": title,
                "url": url,
                "tags": tags,
                "createdAt": created_at,
            }
        )

    stats.imported = len(records)
    return records, stats


def validate_destination(document: Any) -> dict[str, Any]:
    if not isinstance(document, dict):
        raise ImportFailure("destination has an invalid top-level shape")
    if document.get("schemaVersion") != SCHEMA_VERSION:
        raise ImportFailure("destination uses an unsupported schema")
    bookmarks = document.get("bookmarks")
    if not isinstance(bookmarks, list):
        raise ImportFailure("destination bookmarks are invalid")

    seen_ids: set[str] = set()
    seen_urls: set[str] = set()
    for record in bookmarks:
        if not isinstance(record, dict):
            raise ImportFailure("destination contains an invalid bookmark")
        record_id = record.get("id")
        title = record.get("title")
        url = record.get("url")
        tags = record.get("tags")
        created_at = record.get("createdAt")
        favicon = record.get("favicon")
        if not isinstance(record_id, str) or not record_id.strip() or record_id != record_id.strip():
            raise ImportFailure("destination contains an invalid bookmark ID")
        if not isinstance(title, str) or not isinstance(url, str) or not parse_http_url(url):
            raise ImportFailure("destination contains an invalid bookmark URL")
        if not isinstance(tags, list) or any(not isinstance(tag, str) for tag in tags):
            raise ImportFailure("destination contains invalid bookmark tags")
        if not isinstance(created_at, str) or not created_at:
            raise ImportFailure("destination contains an invalid timestamp")
        if favicon is not None and (
            not isinstance(favicon, str) or not FAVICON_RE.fullmatch(favicon)
        ):
            raise ImportFailure("destination contains an invalid favicon")
        if record_id in seen_ids:
            raise ImportFailure("destination contains a duplicate bookmark ID")
        key = duplicate_key(url)
        if key in seen_urls:
            raise ImportFailure("destination contains a duplicate bookmark URL")
        seen_ids.add(record_id)
        seen_urls.add(key)

    return document


def load_destination(path: Path) -> tuple[dict[str, Any], bool]:
    if path.is_symlink():
        raise ImportFailure("destination must not be a symlink")
    if not path.exists():
        return {"schemaVersion": SCHEMA_VERSION, "bookmarks": []}, False
    if not path.is_file():
        raise ImportFailure("destination is not a regular file")

    try:
        raw = path.read_text(encoding="utf-8")
        document = json.loads(raw)
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise ImportFailure("destination could not be parsed") from error
    return validate_destination(document), True


def merge_records(
    document: dict[str, Any], records: list[dict[str, Any]], stats: ImportStats
) -> tuple[dict[str, Any], int]:
    existing_keys = {duplicate_key(record["url"]) for record in document["bookmarks"]}
    existing_ids = {record["id"] for record in document["bookmarks"]}
    added = 0

    for record in records:
        key = duplicate_key(record["url"])
        if key in existing_keys:
            stats.duplicate += 1
            continue
        if record["id"] in existing_ids:
            raise ImportFailure("imported ID conflicts with destination")
        document["bookmarks"].append(record)
        existing_keys.add(key)
        existing_ids.add(record["id"])
        added += 1

    stats.imported = added
    return document, added


def ensure_private_existing(path: Path) -> None:
    parent = path.parent
    if parent.is_symlink() or path.is_symlink():
        raise ImportFailure("private storage must not use symlinks")
    try:
        parent.mkdir(parents=True, mode=0o700, exist_ok=True)
        os.chmod(parent, 0o700)
        if path.exists():
            os.chmod(path, 0o600)
    except OSError as error:
        raise ImportFailure("could not enforce private storage permissions") from error


def atomic_write(path: Path, document: dict[str, Any]) -> None:
    ensure_private_existing(path)
    payload = json.dumps(document, ensure_ascii=False, indent=2) + "\n"
    descriptor = -1
    temporary_name = ""

    try:
        descriptor, temporary_name = tempfile.mkstemp(prefix=".bookmarks-", suffix=".tmp", dir=path.parent)
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as temporary:
            descriptor = -1
            temporary.write(payload)
            temporary.flush()
            os.fsync(temporary.fileno())
        os.replace(temporary_name, path)
        temporary_name = ""
        os.chmod(path, 0o600)

        directory_fd = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    except OSError as error:
        raise ImportFailure("could not atomically write the destination") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary_name:
            try:
                os.unlink(temporary_name)
            except FileNotFoundError:
                pass


def fetch_favicon(
    metadata_helper: Path,
    data_dir: Path,
    record_id: str,
    url: str,
) -> tuple[str, str, str]:
    try:
        completed = subprocess.run(
            [
                sys.executable,
                str(metadata_helper),
                "fetch",
                "--url",
                url,
                "--data-dir",
                str(data_dir),
            ],
            capture_output=True,
            text=True,
            check=False,
            timeout=8,
        )
        if completed.returncode != 0:
            return record_id, url, ""
        payload = json.loads(completed.stdout)
    except (OSError, subprocess.SubprocessError, UnicodeError, json.JSONDecodeError):
        return record_id, url, ""

    if not isinstance(payload, dict):
        return record_id, url, ""
    favicon = payload.get("favicon")
    if payload.get("ok") is not True or not isinstance(favicon, str):
        return record_id, url, ""
    if not FAVICON_RE.fullmatch(favicon):
        return record_id, url, ""
    return record_id, url, favicon


def apply_favicon_updates(
    destination: Path,
    updates: dict[str, tuple[str, str]],
) -> tuple[int, int]:
    if not updates:
        return 0, 0

    document, destination_exists = load_destination(destination)
    if not destination_exists:
        raise ImportFailure("destination does not exist")
    records_by_id = {record["id"]: record for record in document["bookmarks"]}
    applied = 0
    skipped = 0
    for record_id, (expected_url, favicon) in updates.items():
        record = records_by_id.get(record_id)
        if (
            record is None
            or record["url"] != expected_url
            or record.get("favicon") is not None
        ):
            skipped += 1
            continue
        record["favicon"] = favicon
        applied += 1

    if applied:
        atomic_write(destination, validate_destination(document))
    return applied, skipped


def print_backfill_stats(stats: BackfillStats) -> None:
    print(f"missing={stats.missing}")
    print(f"scheduled={stats.scheduled}")
    print(f"processed={stats.processed}")
    print(f"fetched={stats.fetched}")
    print(f"failed={stats.failed}")
    print(f"applied={stats.applied}")
    print(f"skipped={stats.skipped}")


def backfill_favicons(arguments: argparse.Namespace) -> int:
    destination = (
        Path(arguments.data_file).expanduser()
        if arguments.data_file
        else default_data_file()
    )
    document, destination_exists = load_destination(destination)
    if not destination_exists:
        raise ImportFailure("destination does not exist")
    if arguments.workers < 1 or arguments.workers > MAX_BACKFILL_WORKERS:
        raise ImportFailure(
            f"workers must be between 1 and {MAX_BACKFILL_WORKERS}"
        )
    if arguments.limit is not None and arguments.limit < 1:
        raise ImportFailure("limit must be positive")

    missing = [
        (record["id"], record["url"])
        for record in document["bookmarks"]
        if record.get("favicon") is None
    ]
    scheduled = missing[: arguments.limit] if arguments.limit else missing
    stats = BackfillStats(missing=len(missing), scheduled=len(scheduled))
    if arguments.dry_run or not scheduled:
        print_backfill_stats(stats)
        return 0

    metadata_helper = Path(__file__).with_name("bookmark_metadata.py").resolve()
    if not metadata_helper.is_file():
        raise ImportFailure("metadata helper is missing")
    data_dir = destination.parent.resolve()
    pending_updates: dict[str, tuple[str, str]] = {}

    with concurrent.futures.ThreadPoolExecutor(
        max_workers=arguments.workers
    ) as executor:
        futures = [
            executor.submit(
                fetch_favicon,
                metadata_helper,
                data_dir,
                record_id,
                url,
            )
            for record_id, url in scheduled
        ]
        for future in concurrent.futures.as_completed(futures):
            record_id, url, favicon = future.result()
            stats.processed += 1
            if favicon:
                stats.fetched += 1
                pending_updates[record_id] = (url, favicon)
            else:
                stats.failed += 1

            if len(pending_updates) >= BACKFILL_CHECKPOINT:
                applied, skipped = apply_favicon_updates(
                    destination, pending_updates
                )
                stats.applied += applied
                stats.skipped += skipped
                pending_updates.clear()
            if stats.processed % 10 == 0 or stats.processed == stats.scheduled:
                print(
                    f"progress={stats.processed}/{stats.scheduled}",
                    file=sys.stderr,
                    flush=True,
                )

    applied, skipped = apply_favicon_updates(destination, pending_updates)
    stats.applied += applied
    stats.skipped += skipped
    print_backfill_stats(stats)
    return 0


def print_stats(stats: ImportStats) -> None:
    print(f"valid={stats.valid}")
    print(f"imported={stats.imported}")
    print(f"duplicate={stats.duplicate}")
    print(f"malformed={stats.malformed}")
    print(f"missing_url={stats.malformed}")
    print(f"ambiguous={stats.ambiguous}")
    print(f"rows_with_tags={stats.rows_with_tags}")
    print(f"tag_tokens={stats.tag_tokens}")
    if stats.ambiguous_lines:
        print("ambiguous_lines=" + ",".join(str(line) for line in stats.ambiguous_lines))
    else:
        print("ambiguous_lines=none")


def import_legacy(arguments: argparse.Namespace) -> int:
    source = Path(arguments.path).expanduser()
    destination = Path(arguments.data_file).expanduser() if arguments.data_file else default_data_file()

    records, stats = parse_legacy(source)
    if arguments.dry_run and not arguments.merge:
        print_stats(stats)
        if stats.malformed:
            print("error: malformed legacy rows; destination was not changed", file=sys.stderr)
            return 1
        return 0

    document, destination_existed = load_destination(destination)

    if document["bookmarks"] and not arguments.merge:
        raise ImportFailure("destination is non-empty; use --merge")

    document, added = merge_records(document, records, stats)
    if stats.malformed:
        print_stats(stats)
        print("error: malformed legacy rows; destination was not changed", file=sys.stderr)
        return 1

    print_stats(stats)
    if arguments.dry_run:
        return 0

    if destination_existed and arguments.merge and added == 0:
        ensure_private_existing(destination)
        return 0

    atomic_write(destination, document)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="bookmarkctl")
    subparsers = parser.add_subparsers(dest="command", required=True)
    importer = subparsers.add_parser("import-legacy", help="import a legacy line-oriented bookmark file")
    importer.add_argument("path", help="legacy bookmark file")
    importer.add_argument("--dry-run", action="store_true", help="report without writing")
    importer.add_argument("--merge", action="store_true", help="merge into an existing schema-1 document")
    importer.add_argument("--data-file", help="override the destination bookmarks.json path")
    backfill = subparsers.add_parser(
        "backfill-favicons",
        help="fetch missing favicons with bounded concurrent requests",
    )
    backfill.add_argument("--data-file", help="override the bookmarks.json path")
    backfill.add_argument(
        "--workers",
        type=int,
        default=4,
        help=f"concurrent fetches, from 1 to {MAX_BACKFILL_WORKERS} (default: 4)",
    )
    backfill.add_argument(
        "--limit",
        type=int,
        help="process only the first N bookmarks missing favicons",
    )
    backfill.add_argument(
        "--dry-run",
        action="store_true",
        help="report missing favicons without network requests or writes",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    arguments = parser.parse_args(argv)
    try:
        if arguments.command == "import-legacy":
            return import_legacy(arguments)
        if arguments.command == "backfill-favicons":
            return backfill_favicons(arguments)
    except ImportFailure as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
